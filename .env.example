# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Sentry Error Tracking (Optional but recommended for production)
VITE_SENTRY_DSN=your-sentry-dsn

# App Version (auto-set by CI/CD)
VITE_APP_VERSION=1.0.0

# ============================================
# Edge Function Environment Variables
# (Set these in Supabase Dashboard -> Settings -> Edge Functions)
# ============================================

# Supabase Service Role (for edge functions)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FAL.ai API Key (for image enhancement)
# FAL_KEY=your-fal-api-key

# Stripe Keys (for payments)
# STRIPE_SECRET_KEY=sk_live_... (use sk_test_... for development)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Lovable API Key (for AI text generation)
# LOVABLE_API_KEY=your-lovable-api-key

# ============================================
# Stripe Price IDs (Create these in Stripe Dashboard)
# ============================================

# A La Carte Packages
# price_single_image=price_xxx
# price_5_pack=price_xxx
# price_10_pack=price_xxx
# price_menu_makeover=price_xxx
# price_delivery_refresh=price_xxx

# Subscription Packages
# price_sub_starter=price_xxx
# price_sub_growth=price_xxx
# price_sub_premium=price_xxx
