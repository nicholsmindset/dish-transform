# Staging Environment Configuration
# Copy this to .env.local for local staging testing

# Supabase Staging Project
VITE_SUPABASE_PROJECT_ID=your-staging-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-anon-key
VITE_SUPABASE_URL=https://your-staging-project-id.supabase.co

# Sentry (use staging DSN or same as production)
VITE_SENTRY_DSN=your-sentry-dsn

# App Configuration
VITE_APP_VERSION=1.0.0-staging
VITE_APP_ENV=staging

# Feature Flags (can enable experimental features)
VITE_ENABLE_DEBUG=true
